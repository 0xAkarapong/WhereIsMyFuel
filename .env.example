# Database Connection
# Replace with your Supabase Postgres connection string
# Use the Pooler URL for Vercel (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres"

# Supabase Public Keys (for frontend)
VITE_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Admin Authentication
# Default password: example
ADMIN_PASSWORD="example"

# Server Configuration
PORT=5000
NODE_ENV=development
